@model List<studentManagement.Models.Student>
@{
    ViewData["Title"] = "Students";
}

<h1>Students</h1>

<table class="table table-hover">
    <thead>
        <tr>
            <th>Name</th>
            <th>Email</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var s in Model)
        {
            <tr>
                <td>@s.FullName</td>
                <td>@s.Email</td>
            </tr>
        }
    </tbody>
</table>